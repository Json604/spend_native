      "\\bspent\\b",
      "\\bpaid\\b",
      "\\bwithdrawn\\b",
      "\\bcharged\\b",
      "\\bpurchased?\\b",
      "\\brecharge\\s+of\\s+(?:rs\\.?|inr|₹)\\s*\\d[\\s\\S]{0,40}\\bis successful\\b"
