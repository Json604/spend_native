  "monetaryRoleOrder": [
    "available_balance",
    "credit_limit",
    "minimum_due",
    "emi_amount",
    "bill_amount",
    "promised_cashback",
    "transaction_amount"
  ],
  "monetaryRoles": {
    "available_balance": [
      "(?:\\bavl\\.?\\s*bal(?:ance)?|\\bavail(?:able)?\\s+bal(?:ance)?|\\bbal(?:ance)?\\.?)\\s*(?:is|of)?\\s*[:\\-]?\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:is\\s+)?(?:the\\s+)?available\\s+balance\\b"
    ],
    "credit_limit": [
      "(?:\\bcredit\\s+limit|\\blimit|\\beligibility)\\s*(?:is|of)?\\s*[:\\-]?\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:is\\s+)?(?:your\\s+)?(?:credit\\s+)?limit\\b",
      "<AMOUNT>\\s*(?:[a-z0-9-]+\\s+){0,3}credit\\s+(?:limit|for)\\b"
    ],
    "minimum_due": [
      "\\bminimum\\s+(?:amount\\s+)?due\\s*(?:is)?\\s*[:\\-]?\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:is\\s+)?(?:the\\s+)?minimum\\s+(?:amount\\s+)?due\\b"
    ],
    "emi_amount": [
      "\\b(?:emi|instalment|installment)(?:\\s+amount|\\s+of)?\\s*(?:is)?\\s*[:\\-]?\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:emi|instalment|installment)\\b"
    ],
    "bill_amount": [
      "\\b(?:bill(?:\\s+(?:payment|amount))?|total\\s+(?:amt\\.?|amount)\\s+due|(?:amt\\.?|amount)\\s+due)\\s*(?:of|is|:|-)?\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:is\\s+)?(?:the\\s+)?(?:bill\\s+amount|amount\\s+due)\\b"
    ],
    "promised_cashback": [
      "\\b(?:get|earn)?\\s*(?:assured|flat|up\\s*to|upto)\\s*<AMOUNT>",
      "\\bcashback(?:\\s+of)?\\s*[:\\-]?\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:monthly\\s+)?cashback\\b"
    ],
    "transaction_amount": [
      "\\b(?:debited(?:\\s+by)?|sent|spent|paid|payment\\s+of|debit\\s+of|withdrawn|charged|received|credited\\s+by|refund\\s+of|refunded|transferred|recharge\\s+of|transaction\\s+for)\\s*<AMOUNT>",
      "<AMOUNT>\\s*(?:was\\s+|is\\s+|has\\s+been\\s+)?(?:debited|spent|paid|withdrawn|charged|credited|received|refunded|transferred)\\b"
    ]
  }
}
