npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# ── Personal financial data — NEVER commit (this repo is public) ──
# Generated from ~/Desktop/spend_backup by tools/import_legacy.mjs
staging.sqlite
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# Real bank SMS: contains account masks, UPI handles, names, reference numbers.
# Regenerate locally with: node tests/generate_sms_corpus.mjs
tests/fixtures/sms_corpus.json

# Generated by the syncDatabaseMigrations gradle task from db/migrations/ —
# db/migrations is the single source of truth for both TypeScript and Kotlin.
android/app/src/main/assets/migrations/

# Release signing — NEVER commit. Losing this means never being able to update
# the app for anyone who installed it.
*.keystore
!android/app/debug.keystore
*.keystore.password

# Google OAuth downloads. The web client JSON contains a real client_secret.
# We never need it: the app gets an ID token, the server verifies it against
# Google's JWKS, and only the client *ID* is required — which is public.
client_secret_*.json
google-services.json
